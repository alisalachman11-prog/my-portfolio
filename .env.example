# Copy to `.env.local` and fill in for local development.
# PostHog project API key — public, write-only (starts with phc_).
# Get it from PostHog → Settings → Project → Project API key.
VITE_POSTHOG_KEY=phc_REPLACE_ME
# Override only if you use PostHog EU cloud (default is US):
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
